#!/usr/bin/env bash
set -u

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
JACK_ROOT="$(cd -P "$(dirname "$src")/.." && pwd)"

. "$JACK_ROOT/lib/core.sh"

list_themes() {
  local name desc
  echo "usage: jack <theme> <action> [args]"
  echo
  echo "themes:"
  for name in $(jack_visible_themes); do
    desc="$(jack_desc "$name")"
    printf '  %-10s %s\n' "$name" "$desc"
  done
}

list_actions() {
  echo "usage: jack $1 <action> [args]"
  echo
  echo "actions:"
  jack_print_actions "$1"
}

action_help() {
  jack_meta "$1" DOC "$(printf %s "$2" | tr - _)"
  echo
  echo "usage: $(jack_usage "$1" "$2")"
}

main() {
  local theme="${1:-}" action="${2:-}" fn

  if [ "$theme" = __complete ]; then
    shift
    jack_complete "$@"
    return 0
  fi

  if [ -z "$theme" ] || [ "$theme" = -h ] || [ "$theme" = --help ] || [ "$theme" = help ]; then
    list_themes
    return 0
  fi

  case "$theme" in
    *[!a-z]*) die_usage "unknown theme: $theme" ;;
  esac
  if [ "$theme" = core ] || [ ! -f "$JACK_ROOT/lib/$theme.sh" ]; then
    die_usage "unknown theme: $theme"
  fi
  . "$JACK_ROOT/lib/$theme.sh"

  if [ -z "$action" ] || [ "$action" = help ]; then
    list_actions "$theme"
    return 0
  fi

  case "$action" in
    *[!a-z_-]*) die_usage "unknown action: $theme $action" ;;
  esac
  fn="${theme}_$(printf %s "$action" | tr - _)"
  declare -F "$fn" >/dev/null || die_usage "unknown action: $theme $action"

  case "${3:-}" in
    -h|--help|help) action_help "$theme" "$action"; return 0 ;;
  esac

  shift 2
  "$fn" "$@"
}

main "$@"
